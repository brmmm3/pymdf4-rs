from collections.abc import Callable, Iterable
from os import PathLike
from typing import TypeAlias, TypedDict, final

import numpy as np
from numpy.typing import NDArray

_Path: TypeAlias = str | PathLike[str]
_Channel: TypeAlias = str | tuple[int, str]
_Sample: TypeAlias = tuple[float, float]

DENSE_LIMIT: int
__all__: list[str]

class _GroupInfo(TypedDict):
    index: int
    name: str | None
    channels: list[str | None]
    record_count: int

@final
class ReplayData:
    @property
    def timeline(self) -> list[float]: ...
    @property
    def channels(self) -> dict[str, list[float]]: ...
    @property
    def source(self) -> str: ...

@final
class SparseReplayData:
    @property
    def timeline(self) -> NDArray[np.float64]: ...
    @property
    def series(self) -> dict[str, tuple[NDArray[np.float64], NDArray[np.float64]]]: ...
    @property
    def source(self) -> str: ...

@final
class MdfFile:
    def __new__(cls, path: _Path) -> MdfFile: ...
    @property
    def source(self) -> str: ...
    def structure(self) -> list[_GroupInfo]: ...
    def timeline(self, group: int) -> list[float]: ...
    def time_bounds(self, group: int) -> tuple[float, float] | None: ...
    def channel_count(self, group: int, channel: str) -> int: ...
    def channel_slice(self, group: int, channel: str, start: int, end: int) -> tuple[list[float], list[float]]: ...
    def channel_time_slice(self, group: int, channel: str, start: float, end: float) -> tuple[list[float], list[float]]: ...
    def stream_start(self, start: float, channels: Iterable[_Channel]) -> None: ...
    def stream_read(self, timeout: float | None = None) -> dict[_Channel, _Sample | None] | None: ...
    def stream_stop(self) -> None: ...
    def stream_set_pos(self, position: float) -> None: ...
    def stream_set_channels(self, channels: Iterable[_Channel]) -> None: ...

def read_mdf_structure(file_path: str) -> dict[str, list[str]]: ...
def load_mf4(
    path: _Path,
    keep: Callable[[str], object] | None = ...,
    skipped: list[str] | None = ...,
    *,
    start: float | None = ...,
    end: float | None = ...,
) -> ReplayData | SparseReplayData: ...